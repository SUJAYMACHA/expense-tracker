NODE_ENV=development
PORT=3000

# Frontend URL (for CORS) - Update this for production
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# Local: mongodb://localhost:27017/expense_tracker
# MongoDB Atlas (Recommended for production): mongodb+srv://username:password@cluster.mongodb.net/expense_tracker?retryWrites=true&w=majority&appName=YourAppName
# Important: URL encode special characters in password (e.g., @ becomes %40, # becomes %23)
MONGODB_URI=mongodb://localhost:27017/expense_tracker

# JWT Configuration
# IMPORTANT: Change this to a strong random string in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this-in-production-12345

# JWT token expiration time
JWT_EXPIRE=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
