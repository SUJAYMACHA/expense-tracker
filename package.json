{
  "name": "expense-tracker-api",
  "version": "1.0.0",
  "description": "RESTful API for expense tracking with authentication",
  "main": "src/server.js",
  "scripts": {
    "build": "echo 'No build step required for Node.js backend'",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/**/*.js",
    "start:all": "concurrently \"npm run dev\" \"cd ../expense-tracker-frontend && npm run dev\" --names \"backend,frontend\" --prefix-colors \"yellow,blue\""
  },
  "keywords": [
    "expense",
    "tracker",
    "api",
    "rest",
    "mongodb",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
